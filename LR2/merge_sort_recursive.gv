digraph MergeSortRecursive {
    node [shape=box, style="rounded,filled"];

    subgraph cluster_init {
        label="Початковий виклик";
        Start [label="[10, 90, 95, 30, 45, 60, 57, 28, 5]"];
    }

    subgraph cluster_split {
        label="Етап розділення";
        
        Split1_L [label="[10, 90, 95, 30]"];
        Split1_R [label="[45, 60, 57, 28, 5]"];
        
        Split2_L1 [label="[10, 90]"];
        Split2_L2 [label="[95, 30]"];
        Split2_R1 [label="[45, 60]"];
        Split2_R2 [label="[57, 28, 5]"];
        
        Leaf_10 [label="[10]"];
        Leaf_90 [label="[90]"];
        
        Leaf_95 [label="[95]"];
        Leaf_30 [label="[30]"];
        
        Leaf_45 [label="[45]"];
        Leaf_60 [label="[60]"];
        
        Leaf_57 [label="[57]"];
        Split3 [label="[28, 5]"];
        
        Leaf_28 [label="[28]"];
        Leaf_5 [label="[5]"];
    }

    subgraph cluster_merge {
        label="Етап злиття";
        
        Merge1_1 [label="[10, 90]"];
        Merge1_2 [label="[30, 95]"];
        Merge1_3 [label="[45, 60]"];
        Merge1_4 [label="[5, 28]"];
        
        Merge2 [label="[5, 28, 57]"];
        
        Merge3_1 [label="[10, 30, 90, 95]"];
        Merge3_2 [label="[5, 28, 45, 57, 60]"];
        
        Final [label="[5, 10, 28, 30, 45, 57, 60, 90, 95]"];
    }

    Start -> Split1_L [label="ліва частина"];
    Start -> Split1_R [label="права частина"];
    
    Split1_L -> Split2_L1;
    Split1_L -> Split2_L2;
    
    Split1_R -> Split2_R1;
    Split1_R -> Split2_R2;
    
    Split2_L1 -> Leaf_10;
    Split2_L1 -> Leaf_90;
    
    Split2_L2 -> Leaf_95;
    Split2_L2 -> Leaf_30;
    
    Split2_R1 -> Leaf_45;
    Split2_R1 -> Leaf_60;
    
    Split2_R2 -> Leaf_57;
    Split2_R2 -> Split3;
    
    Split3 -> Leaf_28;
    Split3 -> Leaf_5;


    Leaf_10 -> Merge1_1 [style=dotted];
    Leaf_90 -> Merge1_1 [style=dotted];
    
    Leaf_95 -> Merge1_2 [style=dotted];
    Leaf_30 -> Merge1_2 [style=dotted];
    
    Leaf_45 -> Merge1_3 [style=dotted];
    Leaf_60 -> Merge1_3 [style=dotted];
    
    Leaf_28 -> Merge1_4 [style=dotted];
    Leaf_5 -> Merge1_4 [style=dotted];
    
    Leaf_57 -> Merge2 [style=dotted];
    Merge1_4 -> Merge2 [style=dotted];
    
    Merge1_1 -> Merge3_1 [style=dotted];
    Merge1_2 -> Merge3_1 [style=dotted];
    
    Merge1_3 -> Merge3_2 [style=dotted];
    Merge2 -> Merge3_2 [style=dotted];
    
    Merge3_1 -> Final [style=dotted];
    Merge3_2 -> Final [style=dotted];
}