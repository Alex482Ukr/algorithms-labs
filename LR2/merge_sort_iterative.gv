digraph MergeSortIterative {
    node [shape=box, style="rounded,filled"];

    Start [label="Початковий масив\n[10, 90, 95, 30, 45, 60, 57, 28, 5]"];

    Merge1_1 [label="Злиття [10] та [90]\n[10, 90]"];
    Merge1_2 [label="Злиття [95] та [30]\n[30, 95]"];
    Merge1_3 [label="Злиття [45] та [60]\n[45, 60]"];
    Merge1_4 [label="Злиття [57] та [28]\n[28, 57]"];

    Merge2_1 [label="Злиття [10, 90] та [30, 95]\n[10, 30, 90, 95]"];
    Merge2_2 [label="Злиття [45, 60] та [28, 57]\n[28, 45, 57, 60]"];
    
    Merge3 [label="Злиття [10, 30, 90, 95] та [28, 45, 57, 60]\n[10, 28, 30, 45, 57, 60, 90, 95]"];

    FinalMerge [label="Злиття [10, 28, 30, 45, 57, 60, 90, 95] та [5]\n[5, 10, 28, 30, 45, 57, 60, 90, 95]"];

    Start -> Merge1_1;
    Start -> Merge1_2;
    Start -> Merge1_3;
    Start -> Merge1_4;

    Merge1_1 -> Merge2_1 [style=dotted, label=" Злиття"];
    Merge1_2 -> Merge2_1 [style=dotted, label=" Злиття"];
    Merge1_3 -> Merge2_2 [style=dotted, label=" Злиття"];
    Merge1_4 -> Merge2_2 [style=dotted, label=" Злиття"];

    Merge2_1 -> Merge3 [style=dotted, label=" Злиття"];
    Merge2_2 -> Merge3 [style=dotted, label=" Злиття"];
    
    Merge3 -> FinalMerge [style=dotted, label=" Фінальне злиття"];
}