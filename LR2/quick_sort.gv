digraph QuickSort {
    node [shape=box, style="rounded,filled"];

    subgraph cluster_init {
        label="Основний виклик";
        Start [label="[10, 90, 95, 30, 45, 60, 57, 28, 5]"];
    }

    subgraph cluster_left {
        label="Лівий підмасив";
        
        LL [label="[5]"];
        Start -> LL [label="l = 0, r = 0"];
            
    }

    subgraph cluster_right {
        label="Правий підмасив";
        
        LR [label="[90, 95, 30, 45, 60, 57, 28, 10]"];
        Start -> LR [label="l = 1, r = 8"];
        
            LRL [label="[10, 28, 30, 45, 60, 57]"];
            LR -> LRL [label="l = 1, r = 6"];
            
                LRLL [label="[10]"];
                LRL -> LRLL [label="l = 1, r = 1"];
                
                LRLR [label="[28, 30, 45, 60, 57]"];
                LRL -> LRLR [label="l = 2, r = 6"];
                
                    LRLRL [label="[28]"];
                    LRLR -> LRLRL [label="l = 2, r = 2"];
                    
                    LRLRR [label="[30, 45, 60, 57]"];
                    LRLR -> LRLRR [label="l = 3, r = 6"];
                    
                        LRLRRL [label="[30]"];
                        LRLRR -> LRLRRL [label="l = 3, r = 3"];
                        
                        LRLRRR [label="[45, 60, 57]"];
                        LRLRR -> LRLRRR [label="l = 4, r = 6"];
                        
                            LRLRRRL [label="[45]"];
                            LRLRRR -> LRLRRRL [label="l = 4, r = 4"];
                            
                            LRLRRRR [label="[60, 57]"];
                            LRLRRR -> LRLRRRR [label="l = 5, r = 6"];
                            
                                LRLRRRRL [label="[57]"];
                                LRLRRRR -> LRLRRRRL [label="l = 5, r = 5"];
                                
                                LRLRRRRR [label="[60]"];
                                LRLRRRR -> LRLRRRRR [label="l = 6, r = 6"];
            
            LRR [label="[95, 90]"];
            LR -> LRR [label="l = 7, r = 8"];
            
                LRRL [label="[90]"];
                LRR -> LRRL [label="l = 7, r = 7"];
                
                LRRR [label="[95]"];
                LRR -> LRRR [label="l = 8, r = 8"];
    }

}